# Base URL of the backend API. MUST include the /api/v1 prefix — the app calls
# endpoints like `${VITE_API_BASE_URL}/home-layout`. Leave empty to run on mock
# data (the whole dashboard works offline as a demo).
# Local backend example: http://localhost:3000/api/v1
VITE_API_BASE_URL=https://api.garantmobile.tm/api/v1
VITE_APP_NAME=GarantMobile

# Storefront origin, for the home-draft preview button (optional)
VITE_STOREFRONT_URL=
